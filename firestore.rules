rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Halls: Publicly readable, allow write during development
    match /halls/{hallId} {
      allow read: if true;
      allow write: if true; 
    }

    // Users: Users can read and write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Reviews: Publicly readable, any signed-in user can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Bookings: Users can read their own bookings, create new ones, but not update (except via backend)
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Managed by backend payments/admin
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

